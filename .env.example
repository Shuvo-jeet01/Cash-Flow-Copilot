# Copy this file to .env.local for local-only values.
# Never commit secrets or real financial/member data.

# Public display name; safe to expose in the browser.
NEXT_PUBLIC_APP_NAME="Cash-Flow Copilot"

# Public Supabase browser configuration. Add real values only to .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enable only on the synthetic-data demonstration deployment.
DEMO_MODE=false
